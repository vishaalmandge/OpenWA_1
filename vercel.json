{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "app": {
      "root": ".",
      "framework": "nestjs"
    },
    "python": {
      "root": "sdk/python",
      "framework": "fastapi",
      "entrypoint": "main:app"
    },
    "dashboard": {
      "root": "dashboard",
      "framework": "vite"
    },
    "python": {
      "root": "sdk/python",
      "runtime": "python"
    }
  },
  "rewrites": [
    {
      "source": "/dashboard/(.*)",
      "destination": {
        "service": "dashboard"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "app"
      }
    }
  ]
}
